# syntax=docker/dockerfile:1.23

ARG ROCKY_VERSION=8-minimal
FROM rockylinux:${ROCKY_VERSION}

ARG BWS_PACKAGE_FILE
ARG BWS_PACKAGE_SHA256
ARG BWS_INSTALL_DEBUG_TOOLS=true
ARG BUILD_AGENT
ARG NGINX_CONF_DIR
ARG NJS_DIR

ENV BWS_HOME=/opt/bws \
    LD_LIBRARY_PATH=/opt/bws/luajit/lib:/opt/bws/modules \
    LUA_PATH=/opt/bws/lualib/?.lua\;\; \
    LUA_CPATH=/opt/bws/lualib/?.so\;\;

RUN microdnf update -y \
    && microdnf install -y bash ca-certificates gd gzip libnsl perl-libs tar \
    && if [ "${BWS_INSTALL_DEBUG_TOOLS}" = "true" ]; then \
        microdnf install -y bind-utils iproute iputils less lsof net-tools procps-ng vim-minimal; \
    fi \
    && microdnf clean all

RUN --mount=type=bind,from=bws-package,source=/${BWS_PACKAGE_FILE},target=/tmp/bws.tar.gz,ro \
    test "$(sha256sum /tmp/bws.tar.gz | awk '{print $1}')" = "${BWS_PACKAGE_SHA256}" \
    && mkdir -p /opt/bws \
    && tar -xzf /tmp/bws.tar.gz -C /opt/bws \
    && unlink /opt/bws/license/bws.lic.txt \
    && rmdir /opt/bws/license \
    && rmdir /opt/bws/logs \
    && sed -i 's|^\./bws "$@"$|exec ./bws "$@"|' /opt/bws/bin/bws.sh \
    && grep -Fx 'exec ./bws "$@"' /opt/bws/bin/bws.sh

COPY --chmod=0755 --from=bws-agent /bws-agent /usr/bin/bws-agent
COPY --chmod=0755 build/bws-entrypoint.sh /agent/entrypoint.sh
COPY ${NGINX_CONF_DIR}/nginx.conf /etc/bws/bws.conf
COPY ${NGINX_CONF_DIR}/grpc-error-locations.conf /etc/bws/grpc-error-locations.conf
COPY ${NGINX_CONF_DIR}/grpc-error-pages.conf /etc/bws/grpc-error-pages.conf
COPY ${NJS_DIR}/ /opt/bws/modules/njs/
COPY build/bws/bootstrap/ /etc/bws/

RUN cp /opt/bws/conf/mime.types /etc/bws/mime.types \
    && mkdir -p \
        /etc/bws-agent \
        /etc/bws/certs \
        /etc/bws/conf.d \
        /etc/bws/events-includes \
        /etc/bws/includes \
        /etc/bws/main-includes \
        /etc/bws/secrets \
        /etc/bws/stream-conf.d \
        /run \
        /var/cache/bws \
        /var/cache/bws/ajp_temp \
        /var/cache/bws/license \
        /var/cache/bws/logs \
        /var/cache/bws/temp/client_body_temp \
        /var/cache/bws/temp/fastcgi_temp \
        /var/cache/bws/temp/proxy_temp \
        /var/cache/bws/temp/scgi_temp \
        /var/cache/bws/temp/uwsgi_temp \
        /var/lib/bws-agent \
        /var/log/bws-agent \
        /var/run/bws \
        /var/run/secrets/bws \
        /var/run/secrets/bws-gateway \
    && touch /run/.containerenv \
    && touch /var/cache/bws/logs/access.log /var/cache/bws/logs/error.log \
    && ln -s /opt/bws/modules /etc/bws/modules \
    && ln -s /var/cache/bws/ajp_temp /opt/bws/ajp_temp \
    && ln -s /var/cache/bws/license /opt/bws/license \
    && ln -s /var/cache/bws/logs /opt/bws/logs \
    && ln -s /var/cache/bws/temp /opt/bws/temp \
    && ln -s /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/cert.pem \
    && chown -R 101:1001 \
        /etc/bws \
        /etc/bws-agent \
        /var/cache/bws \
        /var/lib/bws-agent \
        /var/log/bws-agent \
        /var/run/bws \
        /var/run/secrets/bws \
        /var/run/secrets/bws-gateway

LABEL org.bws.gateway.image.build.agent="${BUILD_AGENT}" \
    org.bws.image.debug-tools="${BWS_INSTALL_DEBUG_TOOLS}" \
    org.opencontainers.image.title="BWS Gateway Fabric data plane" \
    org.opencontainers.image.description="BES WebServer data plane with BWS Agent for BWS Gateway Fabric"

EXPOSE 80 443 8081

USER 101:1001

ENTRYPOINT ["/agent/entrypoint.sh"]
